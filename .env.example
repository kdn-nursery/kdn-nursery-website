# Copy this file to .env for local development.
# Never commit .env. Do not put real secrets in this example.

# demo = explicit development sample catalogue. No database connection.
# database = PostgreSQL through Prisma.
# There is no automatic fallback from database to sample data.
CATALOGUE_DATA_SOURCE=demo

# Required only when CATALOGUE_DATA_SOURCE=database.
# Use a development database. Do not point this at production.
DATABASE_URL=

# Set to true only to build or preview the sample catalogue without PostgreSQL.
# Leave this empty on the public production site.
ALLOW_DEMO_CATALOGUE=

# Set to true only when intentionally seeding a development database
# while NODE_ENV=production. The seed script still requires DATABASE_URL.
SEED_DEVELOPMENT_DATABASE=

# Auth.js secret for a later admin milestone. Generate a long random value.
# Do not reuse an example string in production.
AUTH_SECRET=

# Cloudinary, used later for owner-provided product photographs.
# Keep the API secret on the server.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay test credentials only during development.
# The key secret and webhook secret must stay on the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Public contact values. Leave blank until the owner confirms them.
# WhatsApp should be country code plus number, digits only, such as 91XXXXXXXXXX.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
