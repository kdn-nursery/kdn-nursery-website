// KDN Nursery catalogue schema (Milestone 1).
// Money is stored as integer paise. 100 paise = ₹1.
// Planned order, payment, reservation, Auth.js and audit models are
// documented in docs/IMPLEMENTATION_PLAN.md and are not created yet.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Availability {
  AVAILABLE
  OUT_OF_STOCK
}

enum ContentReviewStatus {
  UNVERIFIED
  VERIFIED
}

enum CatalogueDataOrigin {
  DEVELOPMENT
  OWNER_CONFIRMED
}

model Category {
  id             String    @id @default(cuid())
  slug           String    @unique
  nameEn         String
  nameTa         String
  descriptionEn  String
  descriptionTa  String
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  products       Product[]
}

model Product {
  id                 String              @id @default(cuid())
  slug               String
  categoryId         String
  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  nameEn             String
  nameTa             String
  summaryEn          String
  summaryTa          String
  descriptionEn      String
  descriptionTa      String
  careEn             String
  careTa             String
  pricePaise         Int
  stockQuantity      Int
  availability       Availability
  isFeatured         Boolean             @default(false)
  featuredOrder      Int?
  translationStatus  ContentReviewStatus @default(UNVERIFIED)
  dataOrigin         CatalogueDataOrigin @default(DEVELOPMENT)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  images             ProductImage[]
  bulkPriceTiers     BulkPriceTier[]

  @@unique([categoryId, slug])
  @@index([isFeatured, featuredOrder])
  @@index([availability])
}

model ProductImage {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  altEn        String
  altTa        String
  sortOrder    Int     @default(0)
  // Cloudinary public id once owner photographs are uploaded.
  // Milestone 1 stores a placeholder token such as "placeholder:herb".
  storageKey   String
  createdAt    DateTime @default(now())

  @@index([productId, sortOrder])
}

model BulkPriceTier {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQuantity  Int
  pricePaise   Int

  @@unique([productId, minQuantity])
}

model CareGuide {
  id                 String              @id @default(cuid())
  slug               String              @unique
  titleEn            String
  titleTa            String
  summaryEn          String
  summaryTa          String
  bodyEn             String
  bodyTa             String
  sortOrder          Int                 @default(0)
  translationStatus  ContentReviewStatus @default(UNVERIFIED)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}
